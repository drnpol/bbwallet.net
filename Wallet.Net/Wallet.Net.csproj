<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>Wallet.Net</PackageId>
    <Version>1.0.0-local.1</Version>
    <Authors>Wallet.Net contributors</Authors>
    <Description>A .NET client for the BudgetBakers Wallet API with dependency injection support.</Description>
    <PackageTags>BudgetBakers;Wallet;API;Client</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Exceptions\" />
    <Folder Include="Converters\" />
    <Folder Include="Models\Accounts\" />
    <Folder Include="Models\Budget\" />
    <Folder Include="Models\Records\" />
	<Folder Include="Models\Budget\" />
	<Folder Include="Models\Categories\" />
	<Folder Include="Models\Labels\" />
    <Folder Include="OpenApi\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageReference Include="RestSharp" Version="114.0.0" />
    <PackageReference Include="RestSharp.Serializers.NewtonsoftJson" Version="114.0.0" />
  </ItemGroup>

</Project>
